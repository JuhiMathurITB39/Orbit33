# Copy to .env and edit. NEVER commit a real .env file.
ORBIT_DATA_DIR=./data
ORBIT_SEED=42
# Optional: directory containing the real M5 files (calendar.csv, sell_prices.csv, sales_train_evaluation.csv)
# ORBIT_M5_DIR=/path/to/m5-forecasting-accuracy
# Comma-separated API keys. If empty, the API runs in open demo mode (local use only).
ORBIT_API_KEYS=
ORBIT_CORS_ORIGINS=http://localhost:8000
# LLM provider: none | anthropic. The product is fully functional with "none".
ORBIT_LLM_PROVIDER=none
ORBIT_LLM_API_KEY=
ORBIT_LLM_MODEL=
ORBIT_LOG_LEVEL=INFO
